[Unit]
Description=Push the published business_central tables from Databricks into Business Central (My Company, MED trial)
After=network-online.target
OnFailure=vio-push-bc-failed.service

[Service]
Type=oneshot
WorkingDirectory=/home/harry/W/vio-data-platform/local
Environment=PATH=/home/harry/.local/bin:/usr/local/bin:/usr/bin:/bin
# flock: a manual run and the timer run never overlap; the second one exits at once with code 75
ExecStart=/usr/bin/flock -n -E 75 %t/vio-push-bc.lock /home/harry/.local/bin/uv run --no-project --with databricks-sdk --with requests push_to_bc.py
TimeoutStartSec=1800
# exit 75 = another run holds the lock; this run is skipped, not failed
SuccessExitStatus=75
